# ---------------------------------------------------------------------------
# Telegram (required)
# ---------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs that are allowed to control the bot.
# Any other chat will be rejected. Get yours by messaging @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Kalshi (required)
# ---------------------------------------------------------------------------
# demo | prod   (default demo; flip only after verifying the bot's behavior)
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM generated when you created the API key.
KALSHI_PRIVATE_KEY_PEM_PATH=./secrets/kalshi.pem

# ---------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------
# Example: postgresql://user:pass@localhost:5432/kalshi_tradr
DATABASE_URL=

# ---------------------------------------------------------------------------
# Trading behavior (optional, shown with defaults)
# ---------------------------------------------------------------------------
# If true, every bet is gated on an inline Confirm/Cancel prompt. Default true.
BET_CONFIRM_REQUIRED=true
# Quarter Kelly by default.
KELLY_FRACTION=0.25
# Hard per-bet cap in USD.
MAX_BET_USD=100
# Extra edge added on top of the market price when auto-sizing a Kelly stake.
EDGE_BUFFER=0.02

# ---------------------------------------------------------------------------
# Scanner (optional)
# ---------------------------------------------------------------------------
SCAN_MIN_PROB=0.90
SCAN_MIN_HOURS=1
SCAN_MAX_HOURS=3
SCAN_LIMIT=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
